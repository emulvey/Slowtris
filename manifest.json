{
  "manifest_version": 3,
  "name": "Slowtris",
  "version": "2.0.0",
  "description": "Turn-based Tetris — no timer, pure strategy. Play right from your browser toolbar.",
  "action": {
    "default_popup": "index.html",
    "default_title": "Play Slowtris",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
